{
  "name": "@vistta/visttajs",
  "version": "0.10.0",
  "description": "Vistta Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./server": "./server/index.js",
    "./loader": "./bin/loaders/index.js",
    "./tsconfig": "./tsconfig.json"
  },
  "type": "module",
  "bin": {
    "vistta": "./bin/cli.js"
  },
  "scripts": {
    "checks": "eslint --fix .",
    "temp": "eslint --fix . && tsc .",
    "dev": "nodemon --no-warnings --loader=@vistta/visttajs/loader ./bin/cli.js start ./demo --dev",
    "prod": "nodemon --no-warnings --loader=@vistta/visttajs/loader ./bin/cli.js start ./demo"
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.me/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "ISC",
  "publishConfig": {
    "@vistta:registry": "https://git.vistta.me/api/packages/vistta/npm/"
  },
  "dependencies": {
    "accepts": "^1.3.8",
    "autoprefixer": "^10.4.14",
    "compressible": "^2.0.18",
    "esbuild": "^0.17.19",
    "express": "^4.18.2",
    "follow-redirects": "^1.15.2",
    "http2-express-bridge": "^1.0.7",
    "http2-proxy": "^5.0.53",
    "on-headers": "^1.0.2",
    "postcss": "^8.4.23",
    "sass": "^1.62.1",
    "socket.io": "^4.6.1",
    "typescript": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.2.3",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-better-styled-components": "^1.1.2",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-sonarjs": "^0.19.0",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=19.0.0"
  }
}
