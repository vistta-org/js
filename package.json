{
  "name": "@vistta/js",
  "version": "0.1.0",
  "description": "Vistta.js Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./server": "./server/index.js",
    "./loader": "./cli/default.js",
    "./tsconfig": "./tsconfig.json"
  },
  "type": "module",
  "scripts": {
    "postinstall": "",
    "tests": "vistta start ./tests --dev --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.org/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "CC BY-NC-ND 4.0 DEED",
  "dependencies": {
    "@vistta/fs": "*",
    "@vistta/utils": "*",
    "autoprefixer": "^10.4.21",
    "compressible": "^2.0.18",
    "http-proxy": "^1.18.1",
    "mime": "^4.0.7",
    "postcss": "^8.5.5",
    "sass-embedded": "^1.89.2",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "peerDependencies": {
    "@vistta/cli": "*",
    "electron": "^36.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "vistta": {
    "commands": {
      "default": "./cli/default.js",
      "server": "./cli/server.js",
      "test": "./cli/test.js"
    },
    "bundler": {
      "paths": {
        "@vistta/js": {
          "path": "vistta",
          "namespace": "window"
        },
        "@socket": {
          "path": "/socket.io/socket.io.esm.min.js",
          "external": true
        }
      },
      "define": {
        "window.isServer": "false"
      }
    }
  }
}