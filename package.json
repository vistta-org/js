{
  "name": "@vistta/js",
  "version": "0.14.0",
  "description": "Vistta.js Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./server": {
      "default": "./server/index.js",
      "types": "./server/index.d.ts"
    },
    "./loader": "./bin/loaders/index.js",
    "./tsconfig": "./tsconfig.json"
  },
  "type": "module",
  "bin": {
    "vistta": "./bin/cli.js"
  },
  "scripts": {
    "validation": "node ./bin/cli.js validation",
    "dev": "nodemon ./bin/cli.js start ./docs/pages --dev",
    "prod": "node ./bin/cli.js start ./docs/pages",
    "build": "node ./bin/cli.js build ./docs/pages ./.build",
    "start": "vistta start ./docs/pages",
    "lint": "eslint --fix .",
    "tsc": "tsc .",
    "fix": "npm link"
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.me/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "ISC",
  "publishConfig": {
    "@vistta:registry": "https://git.vistta.me/api/packages/vistta/npm/"
  },
  "dependencies": {
    "@vistta/utils": "^0.5.1",
    "accepts": "^1.3.8",
    "acorn": "^8.11.3",
    "acorn-jsx": "^5.3.2",
    "autoprefixer": "^10.4.19",
    "bytes": "^3.1.2",
    "compressible": "^2.0.18",
    "esbuild": "^0.20.2",
    "express": "^4.19.2",
    "follow-redirects": "^1.15.6",
    "helmet": "^7.1.0",
    "http-proxy": "^1.18.1",
    "http2-express-bridge": "^1.0.7",
    "on-headers": "^1.0.2",
    "postcss": "^8.4.38",
    "sass": "^1.75.0",
    "socket.io": "^4.7.5",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.14",
    "@types/node": "^20.12.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-better-styled-components": "^1.1.2",
    "eslint-plugin-jsx": "^0.1.0",
    "eslint-plugin-sonarjs": "^0.25.1",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=21.5.0"
  }
}
