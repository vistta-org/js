{
  "name": "@vistta/js",
  "version": "0.16.0",
  "description": "Vistta.js Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./server": "./server/index.js",
    "./app": "./app/index.js",
    "./loader": "./cli/default.js",
    "./tsconfig": "./tsconfig.json"
  },
  "type": "module",
  "scripts": {
    "postinstall": "",
    "tests": "vistta start ./tests --dev --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.org/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "CC BY-NC-ND 4.0 DEED",
  "dependencies": {
    "@vistta/cli": "*",
    "@vistta/fs": "*",
    "@vistta/utils": "*",
    "autoprefixer": "^10.4.20",
    "compressible": "^2.0.18",
    "http-proxy": "^1.18.1",
    "mime": "^4.0.4",
    "postcss": "^8.4.47",
    "sass-embedded": "^1.79.5",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "puppeteer": "^23.5.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "vistta": {
    "cli": {
      "default": "./cli/default.js",
      "start": "./cli/start.js",
      "build": "./cli/build.js",
      "test": "./cli/test.js"
    },
    "options": {
      "bundler": {
        "paths": {
          "@vistta/js": {
            "path": "vistta",
            "namespace": "window"
          },
          "@socket": {
            "path": "/socket.io/socket.io.esm.min.js",
            "external": true
          }
        },
        "define": {
          "window.isServer": "false"
        }
      }
    }
  }
}