{
  "name": "@vistta/js",
  "version": "0.15.1",
  "description": "Vistta.js Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./server": {
      "default": "./server/index.js",
      "types": "./server/index.d.ts"
    },
    "./loader": "./bin/loaders/index.js",
    "./tsconfig": "./tsconfig.json"
  },
  "type": "module",
  "scripts": {
    "postinstall": "",
    "dev": "vistta start ./docs/pages --dev --watch",
    "start": "vistta start ./docs/pages",
    "build": "vistta build ./docs/pages ./.build"
  },
  "files": [
    "LICENSE",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.vistta.org/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "CC BY-NC-ND 4.0 DEED",
  "dependencies": {
    "@vistta/cli": "*",
    "@vistta/utils": "*",
    "@types/http-proxy": "^1.17.14",
    "@types/node": "^20.12.10",
    "accepts": "^1.3.8",
    "autoprefixer": "^10.4.19",
    "bytes": "^3.1.2",
    "compressible": "^2.0.18",
    "esbuild": "^0.20.2",
    "express": "^4.19.2",
    "follow-redirects": "^1.15.6",
    "helmet": "^7.1.0",
    "http-proxy": "^1.18.1",
    "http2-express-bridge": "^1.0.7",
    "on-headers": "^1.0.2",
    "postcss": "^8.4.38",
    "sass": "^1.76.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "puppeteer": "^22.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "vistta": {
    "scripts": {
      "start": "./scripts/start.js",
      "build": "./scripts/build.js"
    },
    "loaders": [
      {
        "extensions": [
          "jsx",
          "tsx"
        ],
        "script": "./loaders/jsx.js"
      },
      {
        "extensions": [
          "css",
          "sass",
          "scss"
        ],
        "script": "./loaders/style.js"
      },
      {
        "type": "template",
        "script": "./loaders/template.js"
      }
    ],
    "bundlerOptions": {
      "paths": {
        "@vistta/js": {
          "path": "vistta",
          "namespace": "window"
        },
        "@socket": {
          "path": "/socket.io/socket.io.esm.min.js",
          "external": true
        }
      }
    }
  }
}