{
  "name": "@vistta/js",
  "version": "0.15.1",
  "description": "Vistta.js Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./server": {
      "default": "./server/index.js",
      "types": "./server/index.d.ts"
    },
    "./loader": "./bin/loaders/index.js",
    "./tsconfig": "./tsconfig.json"
  },
  "type": "module",
  "scripts": {
    "postinstall": "",
    "dev": "vistta start ./docs/pages --dev --watch",
    "start": "vistta start ./docs/pages",
    "build": "vistta build ./docs/pages ./build"
  },
  "files": [
    "LICENSE",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.vistta.org/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "CC BY-NC-ND 4.0 DEED",
  "dependencies": {
    "@vistta/cli": "*",
    "@vistta/utils": "*",
    "autoprefixer": "^10.4.20",
    "compressible": "^2.0.18",
    "mime": "^4.0.4",
    "postcss": "^8.4.38",
    "sass": "^1.77.5"
  },
  "devDependencies": {
    "puppeteer": "^23.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "vistta": {
    "scripts": {
      "start": "./scripts/start.js",
      "build": "./scripts/build.js"
    },
    "loaders": [
      {
        "types": "default,reader",
        "extensions": "default",
        "script": "./loaders/file.js"
      },
      {
        "extensions": "jsx,mjsx,cjsx,tsx,mtsx,ctsx",
        "script": "./loaders/jsx.js",
        "default": true
      },
      {
        "type": "api",
        "extensions": "js,mjs,cjs,ts,mts,cts",
        "script": "./loaders/api.js"
      },
      {
        "types": "default,config",
        "extensions": "css,sass,scss",
        "script": "./loaders/style.js"
      },
      {
        "type": "template",
        "script": "./loaders/template.js"
      }
    ],
    "bundlerOptions": {
      "paths": {
        "@vistta/js": {
          "path": "vistta",
          "namespace": "window"
        },
        "@socket": {
          "path": "/socket.io/socket.io.esm.min.js",
          "external": true
        }
      }
    }
  }
}
