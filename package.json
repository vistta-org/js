{
  "name": "@vistta/js",
  "version": "0.11.2",
  "description": "Vistta.js Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./server": "./server/index.js",
    "./loader": "./bin/loaders/index.js",
    "./tsconfig": "./tsconfig.json"
  },
  "type": "module",
  "bin": {
    "vistta": "./bin/cli.js"
  },
  "scripts": {
    "validation": "node ./bin/cli.js validation",
    "dev": "nodemon ./bin/cli.js start ./pages --dev",
    "prod": "node ./bin/cli.js start ./pages",
    "build": "node ./bin/cli.js build ./pages ./.build",
    "start": "vistta start ./pages",
    "lint": "eslint --fix .",
    "tsc": "tsc .",
    "fix": "npm link"
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.me/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "ISC",
  "publishConfig": {
    "@vistta:registry": "https://git.vistta.me/api/packages/vistta/npm/"
  },
  "dependencies": {
    "@vistta/utils": "^0.3.2",
    "autoprefixer": "^10.4.16",
    "compression": "^1.7.4",
    "esbuild": "^0.19.11",
    "express": "^4.18.2",
    "follow-redirects": "^1.15.4",
    "helmet": "^7.1.0",
    "http-proxy": "^1.18.1",
    "http2-express-bridge": "^1.0.7",
    "postcss": "^8.4.33",
    "sass": "^1.69.7",
    "socket.io": "^4.7.3",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.14",
    "@types/node": "^20.10.6",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-better-styled-components": "^1.1.2",
    "eslint-plugin-jsx": "^0.1.0",
    "eslint-plugin-sonarjs": "^0.23.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=21.5.0"
  }
}
