{
  "name": "@vistta/vistta.js",
  "version": "0.9.1",
  "description": "Vistta.js Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./server": "./server/index.js",
    "./loader": "./bin/loaders/index.js",
    "./tsconfig": "./tsconfig.json"
  },
  "type": "module",
  "bin": {
    "vistta": "./bin/cli.js"
  },
  "scripts": {
    "validation": "node --no-warnings --loader=./bin/loaders/index.js ./bin/cli.js validation",
    "dev": "nodemon --no-warnings --loader=./bin/loaders/index.js ./bin/cli.js start ./pages --dev",
    "prod": "nodemon --no-warnings --loader=./bin/loaders/index.js ./bin/cli.js start ./pages",
    "lint": "eslint --fix .",
    "tsc": "tsc ."
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.me/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "ISC",
  "publishConfig": {
    "@vistta:registry": "https://git.vistta.me/api/packages/vistta/npm/"
  },
  "dependencies": {
    "accepts": "^1.3.8",
    "autoprefixer": "^10.4.14",
    "compressible": "^2.0.18",
    "esbuild": "^0.18.15",
    "express": "^4.18.2",
    "follow-redirects": "^1.15.2",
    "http2-express-bridge": "^1.0.7",
    "http2-proxy": "^5.0.53",
    "on-headers": "^1.0.2",
    "postcss": "^8.4.26",
    "sass": "^1.64.0",
    "socket.io": "^4.7.1",
    "typescript": "^5.1.6"
  },
  "devDependencies": {
    "@types/node": "^20.4.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-better-styled-components": "^1.1.2",
    "eslint-plugin-jsx": "^0.1.0",
    "eslint-plugin-sonarjs": "^0.19.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=19.0.0"
  }
}
