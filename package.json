{
  "name": "@vistta/js",
  "version": "0.0.1",
  "description": "Vistta.js Javascript Framework",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./global": "./global.d.ts",
    "./server": "./server/index.js",
    "./cli": "./cli/index.js",
    "./cli/loaders": "./cli/loaders/index.js",
    "./testing/renderer": "./tests/renderer.js",
    "./config": "./tsconfig.json",
    "./builder": "./builder.js"
  },
  "type": "module",
  "files": [
    "index.js",
    "index.d.ts",
    "global.d.ts",
    "jsx.d.ts",
    "tsconfig.json",
    "builder.js",
    "core",
    "clients",
    "server",
    "cli",
    "utils",
    "tests/renderer.js"
  ],
  "scripts": {
    "postinstall": "",
    "test": "npm run test:node && npm run test:browser",
    "tests": "npm test",
    "test:node": "vistta test \"tests/*.test.js\" --environment=node",
    "test:browser": "vistta test \"tests/client.test.jsx\" --environment=browser",
    "test:benchmarks": "vistta test \"tests/benchmarks.test.jsx\" --environment=browser --benchmarks"
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.org/vistta/js.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@vistta/console": "^1.2.0",
    "@vistta/css": "^0.1.0",
    "@vistta/fs": "^1.2.0",
    "@vistta/utils": "^1.2.0",
    "compressible": "^2.0.18",
    "http-proxy": "^1.18.1",
    "mime": "^4.1.2",
    "socket.io": "^4.8.4"
  },
  "peerDependencies": {
    "@vistta/cli": "^1.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}