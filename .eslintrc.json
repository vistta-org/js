{
  "env": {
    "node": true,
    "browser": true,
    "es2021": true
  },
  "globals": {
    "IS_NODE": true
  },
  "extends": ["eslint:recommended", "plugin:sonarjs/recommended"],
  "overrides": [],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true,
      "ts": true,
      "tsx": true
    },
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["jsx", "sonarjs", "better-styled-components"],
  "rules": {
    "better-styled-components/sort-declarations-alphabetically": 2,
    "sonarjs/cognitive-complexity": "off",
    "sonarjs/no-useless-catch": "off",
    "jsx/mark-used-vars": 1,
    "jsx/no-undef": 1
  }
}
