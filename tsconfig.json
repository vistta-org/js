{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "declaration": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "importsNotUsedAsValues": "remove",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": ["./index.d.ts"],
  }
}
