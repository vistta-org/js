{
  "compilerOptions": {
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "module": "esnext",
    "target": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "typeRoots": ["./index.d.ts"],
    "paths": {
      "@vistta/js": ["./index"]
    }
  }
}
