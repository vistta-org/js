{
  "extends": "@vistta/cli/config",
  "cliOptions": {
    "commands": {
      "default": "./cli/default.js",
      "serve": "./cli/serve.js",
      "run": "./cli/run.js",
      "test": "./cli/test.js",
      "build": "./cli/build.js"
    }
  },
  "bundlerOptions": {
    "paths": {
      "@vistta/js": {
        "path": "vistta",
        "namespace": "window"
      },
      "@socket": {
        "path": "/socket.io/socket.io.esm.min.js",
        "external": true
      }
    },
    "define": {
      "window.isServer": "false"
    }
  },
  "include": ["./**/*.js", "./**/*.jsx", "./global.d.ts"]
}
